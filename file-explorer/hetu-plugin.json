{
  "id": "file-explorer",
  "name": "Files",
  "version": "0.1.0",
  "api": "^3",
  "entries": { "worker": "dist/worker.js" },
  "requires": ["luoshu"],
  "views": { "files": { "title": "Files", "kind": "view" } },
  "capabilities": [
    { "type": "luoshu.list", "paths": ["**"] },
    { "type": "luoshu.read", "paths": ["**"] },
    { "type": "luoshu.write", "paths": ["**"] },
    { "type": "events.subscribe", "topics": ["luoshu.changed", "luoshu.outside"] },
    { "type": "ui.view" },
    { "type": "storage" }
  ]
}
